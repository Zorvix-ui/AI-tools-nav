{
  "$ref": "#/definitions/tools",
  "definitions": {
    "tools": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "region": {
          "type": "string",
          "enum": [
            "国内",
            "国外"
          ]
        },
        "rank": {
          "type": "number",
          "minimum": 1
        },
        "description": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "pricing": {
          "type": "string",
          "enum": [
            "免费",
            "免费增值",
            "付费"
          ]
        },
        "rating": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "featured": {
          "type": "boolean",
          "default": false
        },
        "publishDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "category",
        "region",
        "rank",
        "description",
        "url",
        "pricing"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}