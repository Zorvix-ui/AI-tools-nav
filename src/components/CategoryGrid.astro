---
import { categories } from "../data/site";
---

<section class="grid grid-cols-2 md:grid-cols-4 gap-4">
  {categories.map((cat) => (
    <a href={`/categories/${cat.slug}`} class="bg-white rounded-xl border border-gray-200 p-4 hover:border-blue-300 hover:shadow-sm transition-all text-center group">
      <div class="text-3xl mb-2">{cat.emoji}</div>
      <h3 class="font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">{cat.name}</h3>
      <p class="text-xs text-gray-500 mt-1">{cat.desc}</p>
    </a>
  ))}
</section>
