---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdBanner from "../../components/AdBanner.astro";
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const tools = await getCollection("tools");
  return tools.map((tool) => ({ params: { slug: tool.id.replace(/\.md$/, "") } }));
};

const { slug } = Astro.params;
const tools = await getCollection("tools");
const tool = tools.find((t) => t.id.replace(/\.md$/, "") === slug);

if (!tool) return Astro.redirect("/404");

const { Content } = await tool.render();
const { name, category, region, rank, description, url, pricing, rating, tags } = tool.data;

// Category theming
const catTheme: Record<string, { gradient: string; icon: string; accent: string }> = {
  chat: { gradient: "from-blue-500 to-indigo-600", icon: "💬", accent: "bg-blue-500" },
  code: { gradient: "from-emerald-500 to-teal-600", icon: "💻", accent: "bg-emerald-500" },
  image: { gradient: "from-purple-500 to-pink-600", icon: "🎨", accent: "bg-purple-500" },
  video: { gradient: "from-rose-500 to-red-600", icon: "🎬", accent: "bg-rose-500" },
  audio: { gradient: "from-fuchsia-500 to-violet-600", icon: "🎵", accent: "bg-fuchsia-500" },
  search: { gradient: "from-cyan-500 to-blue-600", icon: "🔍", accent: "bg-cyan-500" },
  productivity: { gradient: "from-amber-500 to-orange-600", icon: "⚡", accent: "bg-amber-500" },
  "app-builder": { gradient: "from-indigo-500 to-violet-600", icon: "🧩", accent: "bg-indigo-500" },
};
const theme = catTheme[category] || catTheme.chat;

const pricingCfg: Record<string, { label: string; cls: string }> = {
  "免费": { label: "免费", cls: "bg-green-100 text-green-700 border-green-200" },
  "免费增值": { label: "免费增值", cls: "bg-blue-100 text-blue-700 border-blue-200" },
  "付费": { label: "付费", cls: "bg-orange-100 text-orange-700 border-orange-200" },
};
const pcfg = pricingCfg[pricing] || pricingCfg["免费增值"];

// Related tools: same category, excluding current, top 4 by rank
const related = tools
  .filter((t) => t.data.category === category && t.id.replace(/\.md$/, "") !== slug)
  .sort((a, b) => a.data.rank - b.data.rank)
  .slice(0, 4);

// Star render
function starHTML(r: number) {
  const full = Math.floor(r), half = r - full >= 0.5;
  let s = "";
  for (let i = 0; i < 5; i++) {
    if (i < full) s += '<span class="text-amber-400">★</span>';
    else if (i === full && half) s += '<span class="text-amber-400">★</span>';
    else s += '<span class="text-gray-300">★</span>';
  }
  return s;
}
---

<BaseLayout title={name} description={description}>
  <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-gray-800 transition-colors">首页</a>
      <span class="mx-2 text-gray-300">›</span>
      <a href={`/categories/${category}`} class="hover:text-gray-800 transition-colors">{category}</a>
      <span class="mx-2 text-gray-300">›</span>
      <span class="text-gray-900 font-semibold">{name}</span>
    </nav>

    <!-- Hero Card -->
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br {theme.gradient} text-white p-8 mb-10">
      <div class="absolute inset-0 bg-black/10"></div>
      <div class="absolute top-0 right-0 w-64 h-64 rounded-full bg-white/5 -translate-y-1/2 translate-x-1/2"></div>
      <div class="absolute bottom-0 left-0 w-48 h-48 rounded-full bg-white/5 translate-y-1/2 -translate-x-1/2"></div>
      <div class="relative z-10 flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
        <div class="flex-1">
          <div class="flex items-center gap-2.5 mb-3 flex-wrap">
            <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-white/20 backdrop-blur-sm">#{rank}</span>
            <span class={`text-xs px-2.5 py-1 rounded-full border font-medium ${region === "国内" ? "bg-white/20 border-white/30" : "bg-white/20 border-white/30"}`}>{region}</span>
            <span class={`text-xs px-2.5 py-1 rounded-full border font-medium ${pcfg.cls.replace("bg-", "bg-opacity-80 bg-").replace("text-", "text-white").replace("border-", "border-white/30")} bg-white/20`}>{pcfg.label}</span>
            {rating && (
              <span class="text-sm font-semibold ml-1" set:html={starHTML(rating)}></span>
            )}
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-3">{name}</h1>
          <p class="text-lg text-white/80 max-w-2xl leading-relaxed">{description}</p>
          <div class="flex flex-wrap items-center gap-3 mt-5">
            <a href={url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-white text-gray-900 px-5 py-2.5 rounded-full font-semibold text-sm hover:bg-gray-100 transition-colors shadow-lg shadow-black/10">
              访问官网
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
            <div class="flex flex-wrap gap-1.5">
              {tags.map((tag: string) => (
                <span class="text-xs px-2.5 py-1 rounded-full bg-white/15 backdrop-blur-sm border border-white/10">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Two-column layout -->
    <div class="flex flex-col lg:flex-row gap-10">
      <!-- Main content -->
      <div class="flex-1 min-w-0">
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
          <div class={`h-1 ${theme.accent}`}></div>
          <div class="p-6 sm:p-8 lg:p-10 prose-tool">
          <Content />
          </div>
        </div>
        <AdBanner />
      </div>

      <!-- Sidebar -->
      <aside class="w-full lg:w-80 shrink-0 space-y-6">
        <!-- Quick Facts -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
          <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-4">基本信息</h3>
          <dl class="space-y-3">
            <div class="flex justify-between items-center text-sm">
              <dt class="text-gray-500">分类</dt>
              <dd class="text-gray-900 font-medium">{theme.icon} {category}</dd>
            </div>
            <div class="flex justify-between items-center text-sm">
              <dt class="text-gray-500">地区</dt>
              <dd class="text-gray-900 font-medium">{region}</dd>
            </div>
            <div class="flex justify-between items-center text-sm">
              <dt class="text-gray-500">价格</dt>
              <dd class={`text-xs px-2 py-0.5 rounded-full border font-medium ${pcfg.cls}`}>{pcfg.label}</dd>
            </div>
            {rating && (
              <div class="flex justify-between items-center text-sm">
                <dt class="text-gray-500">评分</dt>
                <dd class="flex items-center gap-1">
                  <span class="text-amber-400 text-sm" set:html={starHTML(rating)}></span>
                  <span class="text-gray-900 font-semibold">{rating}</span>
                </dd>
              </div>
            )}
            <div class="flex justify-between items-center text-sm">
              <dt class="text-gray-500">排名</dt>
              <dd class="text-gray-900 font-semibold">#{rank}</dd>
            </div>
          </dl>
          <a href={url} target="_blank" rel="noopener noreferrer" class="mt-4 block w-full text-center bg-gray-900 text-white text-sm font-semibold py-2.5 rounded-xl hover:bg-gray-800 transition-colors">
            访问官网 →
          </a>
        </div>

        <!-- Tags -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
          <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3">标签</h3>
          <div class="flex flex-wrap gap-1.5">
            {tags.map((tag: string) => (
              <span class="text-xs px-2.5 py-1.5 rounded-lg bg-gray-100 text-gray-600 border border-gray-200 hover:border-gray-300 transition-colors">{tag}</span>
            ))}
          </div>
        </div>

        <!-- Related Tools -->
        {related.length > 0 && (
          <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
            <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3">同类工具</h3>
            <div class="space-y-2">
              {related.map((r) => (
                <a href={`/tools/${r.id.replace(/\.md$/, "")}`} class="flex items-center gap-3 p-2.5 -mx-2 rounded-xl hover:bg-gray-50 transition-colors group">
                  <span class={`shrink-0 w-6 h-6 rounded-lg flex items-center justify-center text-xs font-bold text-white ${theme.accent}`}>{r.data.rank}</span>
                  <div class="min-w-0 flex-1">
                    <div class="text-sm font-medium text-gray-900 truncate group-hover:text-blue-600 transition-colors">{r.data.name}</div>
                    <div class="text-xs text-gray-400 truncate">{r.data.description}</div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Share -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
          <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3">分享</h3>
          <div class="flex gap-2">
            <button onclick={`navigator.clipboard.writeText(window.location.href)`} class="flex-1 text-xs font-medium text-gray-600 bg-gray-50 hover:bg-gray-100 py-2 rounded-lg transition-colors border border-gray-100">
              复制链接
            </button>
          </div>
        </div>
      </aside>
    </div>

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "首页", "item": Astro.site?.toString() || "" },
          { "@type": "ListItem", "position": 2, "name": category, "item": `${Astro.site?.toString() || ""}categories/${category}` },
          { "@type": "ListItem", "position": 3, "name": name }
        ]
      },
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": name,
        "description": description,
        "url": url,
        "applicationCategory": "AIApplication",
        "operatingSystem": "Web",
        "offers": {
          "@type": "Offer",
          "price": pricing === "免费" ? "0" : undefined,
          "priceCurrency": "USD"
        },
        ...(rating ? { "aggregateRating": { "@type": "AggregateRating", "ratingValue": rating, "bestRating": "5" } } : {})
      }
    ])} />
  </article>
</BaseLayout>
