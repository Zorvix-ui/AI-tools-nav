---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdBanner from "../../components/AdBanner.astro";
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const tools = await getCollection("tools");
  return tools.map((tool) => ({ params: { slug: tool.id } }));
};

const { slug } = Astro.params;
const tool = (await getCollection("tools")).find((t) => t.id === slug);

if (!tool) {
  return Astro.redirect("/404");
}

const { Content } = await tool.render();
const { name, category, region, rank, description, url, pricing, rating, tags } = tool.data;

const pricingColor: Record<string, string> = {
  "免费": "bg-green-100 text-green-700",
  "免费增值": "bg-blue-100 text-blue-700",
  "付费": "bg-orange-100 text-orange-700",
  "内测": "bg-purple-100 text-purple-700",
};
---

<BaseLayout title={name} description={description}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    {/* Breadcrumb */}
    <nav class="text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-gray-700">首页</a>
      <span class="mx-2">/</span>
      <a href={`/categories/${category}`} class="hover:text-gray-700">{category}</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">{name}</span>
    </nav>

    {/* Header */}
    <div class="bg-white rounded-2xl border border-gray-200 p-8 mb-8">
      <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-sm font-bold px-2 py-0.5 rounded bg-gray-100 text-gray-500">#{rank}</span>
            <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${region === "国内" ? "bg-red-100 text-red-700" : "bg-indigo-100 text-indigo-700"}`}>{region}</span>
            <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${pricingColor[pricing]}`}>{pricing}</span>
          </div>
          <h1 class="text-3xl font-extrabold text-gray-900 mb-2">{name}</h1>
          <p class="text-lg text-gray-600">{description}</p>
        </div>
        {rating && (
          <div class="text-center bg-yellow-50 rounded-xl px-4 py-3">
            <div class="text-2xl font-bold text-yellow-600">{rating}</div>
            <div class="text-xs text-yellow-500">综合评分</div>
          </div>
        )}
      </div>

      <div class="flex flex-wrap gap-4 mt-4">
        <a href={url} target="_blank" rel="noopener noreferrer" class="bg-blue-600 text-white px-6 py-2.5 rounded-full font-semibold hover:bg-blue-700 transition-colors inline-flex items-center gap-2">
          访问官网 <span class="text-blue-200">→</span>
        </a>
        <div class="flex flex-wrap gap-1.5 items-center">
          {tags.map((tag: string) => (
            <span class="text-xs px-2.5 py-1 bg-gray-100 text-gray-600 rounded-full">{tag}</span>
          ))}
        </div>
      </div>
    </div>

    {/* Content */}
    <div class="bg-white rounded-2xl border border-gray-200 p-8 mb-8 prose-tool">
      <Content />
    </div>

    <AdBanner />

    {/* Structured Data */}
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "首页", "item": Astro.site?.toString() || "" },
          { "@type": "ListItem", "position": 2, "name": category, "item": `${Astro.site?.toString() || ""}categories/${category}` },
          { "@type": "ListItem", "position": 3, "name": name }
        ]
      },
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": name,
        "description": description,
        "url": url,
        "applicationCategory": "AIApplication",
        "operatingSystem": "Web",
        "offers": {
          "@type": "Offer",
          "price": pricing === "免费" ? "0" : undefined,
          "priceCurrency": "USD"
        },
        ...(rating ? [{
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": rating,
            "bestRating": "5"
          }
        }] : [])
      }
    ])} />
  </article>
</BaseLayout>
