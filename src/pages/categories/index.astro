---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categories } from "../../data/site";
---

<BaseLayout title="全部分类">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-10">
      <h1 class="text-3xl font-extrabold text-gray-900">📂 全部分类</h1>
      <p class="text-gray-500 mt-2">共 {categories.length} 个分类，覆盖对话、绘画、视频、编程、音频、搜索、应用构建、效率办公</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {categories.map((cat) => (
        <a href={`/categories/${cat.slug}`} class="block bg-white rounded-xl border border-gray-200 p-6 hover:border-blue-300 hover:shadow-md transition-all group">
          <div class="text-4xl mb-3">{cat.emoji}</div>
          <h2 class="font-bold text-lg text-gray-900 group-hover:text-blue-600 transition-colors mb-1">{cat.name}</h2>
          <p class="text-sm text-gray-500">{cat.desc}</p>
          <span class="inline-block mt-3 text-xs text-blue-600 font-medium group-hover:translate-x-1 transition-transform">查看排行 →</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
